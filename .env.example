# ---------------------------------------------------------------------------
# 飞书数据源
# 复制成 .env.local 后填写；.env.local 已在 .gitignore 里，不会被提交。
# ---------------------------------------------------------------------------

# 开放平台凭证：open.feishu.cn/app →「凭证与基础信息」
# 需要开通的只读权限：
#   wiki:wiki:readonly           查看知识库（解析 /wiki/xxx 链接必需）
#   sheets:spreadsheet:readonly  查看电子表格
#   bitable:app:readonly         查看多维表格（用多维表格时才需要）
#   drive:drive:readonly         读表格数据的 sheets v2 接口权限报错不指名，开上当保险
#
# 开完权限记得「创建版本并发布」，否则接口返回 99991672（权限未开通）。
# 发布之后还要把应用加进对应知识库的成员，否则返回 131006（不是协作者）。
# 这两个报错的解法不一样，别搞混。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 国际版（Lark）改成 https://open.larksuite.com/open-apis
FEISHU_BASE_URL=https://open.feishu.cn/open-apis

# --- 数据源定位：三选一 -----------------------------------------------------

# 方式 A（推荐）：知识库里的文档，填链接 /wiki/ 后面那一段
#   https://xxx.feishu.cn/wiki/Dx6FwC0DnirSYxk8cHmcoDF6nwf?sheet=awpfUO
#                              ^^^^^^^^^^^^^^^^^^^^^^^^^^^
# 文档类型（电子表格 / 多维表格）会自动识别，不用再填 FEISHU_DOC_TYPE
FEISHU_WIKI_TOKEN=

# 方式 B：独立的电子表格（链接里 /sheets/ 后面那一段）
# FEISHU_DOC_TYPE=sheets
# FEISHU_SPREADSHEET_TOKEN=

# 方式 C：独立的多维表格（链接里 /base/ 后面那一段）
# FEISHU_DOC_TYPE=bitable
# FEISHU_BITABLE_APP_TOKEN=

# --- 分散在其它文档里的表 ---------------------------------------------------
# 投放明细和搜索关键词通常不在主日报里，各自填自己文档的 wiki token。
# 留空就当它们和主表在同一个文档。
# FEISHU_WIKI_TOKEN_ADS=
#
# 搜索词长表（流量板块的「Top 搜索词」）。填了才有这张榜，留空则该卡为空态。
# 工作簿里的 `raw-天猫搜索词` / `raw-天猫付费词` 两张子表按**标题**自动定位，
# 不用再单独配 sheet id；京东那张不在本看板口径内，不读。
# FEISHU_WIKI_TOKEN_KEYWORDS=

# --- 各张表的位置 -----------------------------------------------------------
# 电子表格：填工作表名（「2.整体」）或链接里 ?sheet= 后面的 id（「awpfUO」）。
# 日报表留空时默认读第一个子表。只有日报是必需的，其余缺了对应板块降级为空态。
#
# 填之前先跑 `npm run headers`：它会列出所有子表和 sheet_id，
# 并逐字段报告 mapping.ts 的别名有没有命中真实表头。
FEISHU_SHEET_DAILY=
FEISHU_SHEET_ADS_INSITE=
FEISHU_SHEET_ADS_OFFSITE=
FEISHU_SHEET_PRODUCTS=
FEISHU_SHEET_KEYWORDS=
FEISHU_SHEET_TARGETS=

# 多维表格：填数据表名称或 tblXXXX 形式的 table_id
# FEISHU_TABLE_DAILY=
# FEISHU_TABLE_ADS_INSITE=
# FEISHU_TABLE_ADS_OFFSITE=
# FEISHU_TABLE_PRODUCTS=
# FEISHU_TABLE_KEYWORDS=
# FEISHU_TABLE_TARGETS=

# ---------------------------------------------------------------------------
# 同步接口
# ---------------------------------------------------------------------------

# /api/sync 的访问口令，随便生成一串长随机字符串。
# 不设置的话同步接口直接返回 503（关闭），避免裸奔。
#   openssl rand -hex 32
SYNC_TOKEN=

# 快照落盘目录。Vercel 等只读文件系统上改成 /tmp
# SNAPSHOT_DIR=/tmp/tmall-dashboard
